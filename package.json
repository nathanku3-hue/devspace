{
  "name": "@waishnav/devspace",
  "version": "1.0.2",
  "description": "Expose a secure local coding workspace through an MCP server.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.19 <27"
  },
  "bin": {
    "devspace": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:app && tsc -p tsconfig.build.json && node scripts/write-build-identity.mjs",
    "build:app": "vite build",
    "dev": "node scripts/dev-server.mjs",
    "start": "node dist/cli.js serve",
    "test": "node scripts/run-tests.mjs",
    "test:runner": "node --test scripts/run-tests.test.mjs",
    "test:web-launch": "tsx --test src/web-launch.test.ts",
    "test:web-launch-browser": "tsx --test src/web-launch-browser.fixture.test.ts",
    "test:chatshare-recovery-monitor": "node chatshare-oauth-rescue-extension/test-recovery-monitor.mjs",
    "test:powershell": "node scripts/run-powershell-tests.mjs",
    "test:audit": "tsx --test src/audit-return.test.ts",
    "test:source-resolve": "tsx --test src/source-resolve.test.ts",
    "test:review-return": "tsx --test src/review-return.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "chatshare:run": "node scripts/chatshare-runner.mjs",
    "chatshare:collect": "node scripts/chatshare-runner.mjs --mode collect",
    "chatshare:seal": "node scripts/chatshare-runner.mjs --mode seal",
    "chatshare:self-test": "node scripts/chatshare-runner.mjs --self-test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@earendil-works/pi-coding-agent": "^0.80.1",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pierre/diffs": "^1.2.5",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "playwright-core": "1.62.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "semver": "^7.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "overrides": {
    "protobufjs": "7.6.4",
    "ws": "8.21.0",
    "undici": "8.5.0"
  }
}
