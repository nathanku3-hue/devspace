{
  "manifest_version": 3,
  "name": "Chatshare OAuth Callback Rescue",
  "version": "1.4.0",
  "description": "Repairs Chatshare OAuth callbacks and silently proves that DevSpace authorization is running on this enrolled PC.",
  "key": "",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://chatshare.xyz/*",
    "https://devspace-proxy.kitlongku.workers.dev/*",
    "http://127.0.0.1:7677/*"
  ],
  "background": {
    "service_worker": "device-proof-background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "chatshare_oauth_callback_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatshare.xyz/*"
      ],
      "js": [
        "callback-bootstrap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://devspace-proxy.kitlongku.workers.dev/authorize*"
      ],
      "js": [
        "device-authorization.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
